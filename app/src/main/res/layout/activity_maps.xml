<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mapsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/brandRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_leaf"
                    app:tint="#1B8F38" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="EcoSnap"
                    android:textColor="#1B8F38"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>



            <TextView
                android:id="@+id/tvPetaTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Peta Sebaran Sampah"
                android:textColor="#111111"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/brandRow" />

            <TextView
                android:id="@+id/tvPetaSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Pantau kondisi sampah di wilayahmu secara real-time"
                android:textColor="#757575"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPetaTitle" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/filterRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_maps_chip"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar_month"
                    app:tint="#2E7D32" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Bulan Ini"
                    android:textColor="#212121"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="#2E7D32" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_maps_chip"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_location_pin"
                    app:tint="#2E7D32" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Kota Cimahi"
                    android:textColor="#212121"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="#2E7D32" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/summaryCard"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_maps_card"
            android:elevation="5dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="14dp">

            <include
                android:id="@+id/metricKelurahan"
                layout="@layout/item_maps_metric" />

            <View
                android:layout_width="1dp"
                android:layout_height="54dp"
                android:background="#EEEEEE" />

            <include
                android:id="@+id/metricLaporan"
                layout="@layout/item_maps_metric" />

            <View
                android:layout_width="1dp"
                android:layout_height="54dp"
                android:background="#EEEEEE" />

            <include
                android:id="@+id/metricDominan"
                layout="@layout/item_maps_metric" />

            <View
                android:layout_width="1dp"
                android:layout_height="54dp"
                android:background="#EEEEEE" />

            <include
                android:id="@+id/metricPersentase"
                layout="@layout/item_maps_metric" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mapPanel"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_maps_canvas"
            android:clipChildren="true"
            android:clipToPadding="true">

            <!-- Peta nyata OSMDroid (OpenStreetMap) -->
            <org.osmdroid.views.MapView
                android:id="@+id/osmMapView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvCompass"
                android:layout_width="32dp"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:text="U\n▲"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/mapControls"
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="26dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <FrameLayout
                    android:id="@+id/btnLocate"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_white_circle_elevated"
                    android:elevation="6dp"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_my_location"
                        app:tint="#111111" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="50dp"
                    android:layout_height="102dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_maps_card"
                    android:elevation="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btnZoomIn"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#111111"
                        android:textSize="30sp" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="1dp"
                        android:layout_gravity="center_horizontal"
                        android:background="#EEEEEE" />

                    <TextView
                        android:id="@+id/btnZoomOut"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="-"
                        android:textColor="#111111"
                        android:textSize="30sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/legendCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_maps_card"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Legenda Kategori"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/legendRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/topKelurahanCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_maps_card"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Top 3 RT"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Berdasarkan Total Laporan"
                    android:textColor="#757575"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topRegionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

