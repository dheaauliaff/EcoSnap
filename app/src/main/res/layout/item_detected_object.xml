<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_white_circle_elevated"
        android:elevation="2dp"
        android:outlineAmbientShadowColor="#0F000000"
        android:outlineSpotShadowColor="#0A000000">
        
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_scan" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNamaObjek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Objek"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvKategoriObjek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kategori"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_label_pill"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAkurasi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.93"
        android:textColor="#2E7D32"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
