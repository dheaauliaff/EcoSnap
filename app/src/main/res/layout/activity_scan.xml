<?xml version="1.0" encoding="utf-8"?>
<!-- Layar Scan: Full-screen camera + FAB buttons, no scroll -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ═══ Camera Preview full-screen background ═══ -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- ═══ Bounding box overlay ═══ -->
    <com.example.ecosnap.helper.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ═══ Corner brackets scanner frame ═══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginStart="-80dp"
            android:layout_marginTop="-120dp"
            android:background="@drawable/ic_corner_tl" />

        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginStart="80dp"
            android:layout_marginTop="-120dp"
            android:background="@drawable/ic_corner_tr" />

        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginStart="-80dp"
            android:layout_marginTop="120dp"
            android:background="@drawable/ic_corner_bl" />

        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginStart="80dp"
            android:layout_marginTop="120dp"
            android:background="@drawable/ic_corner_br" />
    </FrameLayout>

    <!-- ═══ Label deteksi — transparan di atas kamera ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="10dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌿 EcoSnap"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:alpha="0.7" />

        <TextView
            android:id="@+id/tvHasil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Arahkan kamera ke objek sampah untuk memulai deteksi"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ═══ Progress Bar — loading indicator ═══ -->
    <LinearLayout
        android:id="@+id/layoutScanProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#DD000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressScan"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="#4CAF50" />

        <TextView
            android:id="@+id/tvScanProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Menganalisis sampah..."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ═══ Bottom control bar ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="32dp"
        android:paddingTop="16dp"
        android:paddingHorizontal="24dp">

        <!-- Tombol Reset (kiri) — mini FAB style -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Reset scan"
            app:fabSize="mini"
            app:backgroundTint="#AA616161"
            app:tint="#FFFFFF"
            app:elevation="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Tombol Capture (tengah) — FAB besar utama -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCapture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_camera"
            android:contentDescription="Ambil foto"
            app:fabSize="normal"
            app:backgroundTint="#2E7D32"
            app:tint="#FFFFFF"
            app:elevation="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Tombol Galeri (kanan) — mini FAB style -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnGallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_upload"
            android:contentDescription="Upload dari galeri"
            app:fabSize="mini"
            app:backgroundTint="#AA1B5E20"
            app:tint="#FFFFFF"
            app:elevation="4dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
