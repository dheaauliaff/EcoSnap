<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- 1️⃣ HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Statistik"
                        android:textColor="#1B5E20"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="Pantau kontribusi &amp; jaga lingkungan bersama"
                        android:textColor="#757575"
                        android:textSize="14sp" />
                </LinearLayout>



            </LinearLayout>

            <!-- 2️⃣ CARD DISTRIBUSI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_premium_card"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="#0F000000"
                android:outlineSpotShadowColor="#0A000000"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Distribusi 6 Kategori"
                        android:textColor="#1B5E20"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalSemua"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total 98"
                        android:textColor="#2E7D32"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/bg_green_soft_card" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- CHART SEGMENTED NATIVE -->
                    <FrameLayout
                        android:layout_width="150dp"
                        android:layout_height="150dp">

                        <com.example.ecosnap.DonutChartView
                            android:id="@+id/donutChart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvTotalTengah"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="98"
                                android:textColor="#212121"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total"
                                android:textColor="#757575"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Category 0: Organik #4CAF50 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                            <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_green_circle" android:backgroundTint="#4CAF50" android:layout_marginEnd="8dp"/>
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Organik" android:textColor="#757575" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvStatOrganik" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25 (25%)" android:textColor="#4CAF50" android:textSize="12sp"/>
                        </LinearLayout>

                        <!-- Category 1: Kardus #2196F3 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                            <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_green_circle" android:backgroundTint="#2196F3" android:layout_marginEnd="8dp"/>
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Kardus" android:textColor="#757575" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvStatKardus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 (10%)" android:textColor="#2196F3" android:textSize="12sp"/>
                        </LinearLayout>

                        <!-- Category 2: Kaca #00BCD4 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                            <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_green_circle" android:backgroundTint="#00BCD4" android:layout_marginEnd="8dp"/>
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Kaca" android:textColor="#757575" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvStatKaca" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15 (15%)" android:textColor="#00BCD4" android:textSize="12sp"/>
                        </LinearLayout>

                        <!-- Category 3: Logam #9C27B0 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                            <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_green_circle" android:backgroundTint="#9C27B0" android:layout_marginEnd="8dp"/>
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Logam" android:textColor="#757575" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvStatLogam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 (5%)" android:textColor="#9C27B0" android:textSize="12sp"/>
                        </LinearLayout>

                        <!-- Category 4: Kertas #FFC107 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                            <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_green_circle" android:backgroundTint="#FFC107" android:layout_marginEnd="8dp"/>
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Kertas" android:textColor="#757575" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvStatKertas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20 (20%)" android:textColor="#FFC107" android:textSize="12sp"/>
                        </LinearLayout>

                        <!-- Category 5: Plastik #FF9800 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_green_circle" android:backgroundTint="#FF9800" android:layout_marginEnd="8dp"/>
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Plastik" android:textColor="#757575" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvStatPlastik" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="23 (23%)" android:textColor="#FF9800" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- KONTRIBUSI INFO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_green_soft_card"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_leaf"
                        app:tint="#2E7D32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Nice! Kamu sudah berkontribusi mengurangi 7.2 kg sampah bulan ini 🌱"
                        android:textColor="#2E7D32"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3️⃣ CARD RANKING RT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_premium_card"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="#0F000000"
                android:outlineSpotShadowColor="#0A000000"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Ranking RT"
                        android:textColor="#1B5E20"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PODIUM TOP 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:baselineAligned="false">

                    <!-- RANK 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_scan"
                            app:tint="#2196F3"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_podium_rank2"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:elevation="2dp"
                            android:outlineAmbientShadowColor="#0F000000"
                            android:outlineSpotShadowColor="#0A000000"/>

                        <TextView
                            android:id="@+id/tvRank2RT"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="RT 02"
                            android:textColor="#212121"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvRank2Total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="280"
                            android:textColor="#757575"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- RANK 1 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:layout_marginHorizontal="6dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_scan"
                            app:tint="#4CAF50"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_podium_rank1"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:elevation="4dp"
                            android:outlineAmbientShadowColor="#0F000000"
                            android:outlineSpotShadowColor="#0A000000"/>

                        <TextView
                            android:id="@+id/tvRank1RT"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="RT 01"
                            android:textColor="#212121"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvRank1Total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="320"
                            android:textColor="#4CAF50"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- RANK 3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_scan"
                            app:tint="#FF9800"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_podium_rank3"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:elevation="2dp"
                            android:outlineAmbientShadowColor="#0F000000"
                            android:outlineSpotShadowColor="#0A000000"/>

                        <TextView
                            android:id="@+id/tvRank3RT"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="RT 03"
                            android:textColor="#212121"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvRank3Total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="210"
                            android:textColor="#757575"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="8dp"
                    android:background="#EEEEEE" />

                <!-- LIST RANK 4-8 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="4." android:textColor="#757575" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvRank4RT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="RT 04" android:textColor="#212121" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvRank4Total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="150" android:textColor="#757575" android:textSize="14sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="5." android:textColor="#757575" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvRank5RT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="RT 05" android:textColor="#212121" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvRank5Total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="120" android:textColor="#757575" android:textSize="14sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="6." android:textColor="#757575" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvRank6RT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="RT 06" android:textColor="#212121" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvRank6Total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100" android:textColor="#757575" android:textSize="14sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="7." android:textColor="#757575" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvRank7RT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="RT 07" android:textColor="#212121" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvRank7Total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="80" android:textColor="#757575" android:textSize="14sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="8." android:textColor="#757575" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvRank8RT" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="RT 08" android:textColor="#212121" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvRank8Total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60" android:textColor="#757575" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lihat Semua Ranking"
                        android:textColor="#2E7D32"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:tint="#2E7D32"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar Admin -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/nav_menu_admin"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:elevation="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
